<Application x:Class="QLTV.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:QLTV.Helpers"
             xmlns:local="clr-namespace:QLTV"
             StartupUri="Views/LoginWindow.xaml">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <helpers:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <helpers:GenderConverter x:Key="GenderConverter" />
    </Application.Resources>
</Application>
