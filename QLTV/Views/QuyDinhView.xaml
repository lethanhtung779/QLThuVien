<UserControl x:Class="QLTV.Views.QuyDinhView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:QLTV.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:QuyDinhViewModel}"
             mc:Ignorable="d"
             FontFamily="Segoe UI">
    <TabControl Background="Transparent" BorderThickness="0">
        <TabItem Header="Quy định thư viện">
            <StackPanel Margin="4,14,4,4">
                <DataGrid ItemsSource="{Binding DanhSachQuyDinh}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          Background="White"
                          BorderBrush="#D9DEE5"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeight="36"
                          FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tên quy định" Binding="{Binding TenQuyDinh}" Width="2*" />
                        <DataGridTextColumn Header="Giá trị" Binding="{Binding GiaTri}" Width="1*" IsReadOnly="False" />
                        <DataGridTextColumn Header="Mô tả" Binding="{Binding MoTa}" Width="3*" IsReadOnly="False" />
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <TextBlock Text="Có thể sửa trực tiếp cột Giá trị và Mô tả"
                               FontSize="12" Foreground="#8A94A6" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Button Content="Lưu thay đổi" Width="130" Height="34"
                            Command="{Binding SaveCommand}"
                            Background="#1F3864" Foreground="White" BorderThickness="0" Cursor="Hand" />
                </StackPanel>
            </StackPanel>
        </TabItem>

        <TabItem Header="Phiếu phạt">
            <Grid Margin="4,14,4,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DataGrid Grid.Row="0"
                          ItemsSource="{Binding DanhSachPhieuPhat}"
                          SelectedItem="{Binding SelectedPhieuPhat}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          Background="White"
                          BorderBrush="#D9DEE5"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeight="36"
                          FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã phiếu phạt" Binding="{Binding PhieuPhat.MaPhieuPhat}" Width="1*" />
                        <DataGridTextColumn Header="Độc giả" Binding="{Binding TenDocGia}" Width="2*" />
                        <DataGridTextColumn Header="Ngày phạt" Binding="{Binding PhieuPhat.NgayPhat, StringFormat={}{0:dd/MM/yyyy}}" Width="1*" />
                        <DataGridTextColumn Header="Lý do" Binding="{Binding PhieuPhat.LyDo}" Width="2*" />
                        <DataGridTextColumn Header="Số tiền" Binding="{Binding PhieuPhat.SoTien, StringFormat={}{0:N0}}" Width="1*" />
                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThaiText}" Width="1*" />
                    </DataGrid.Columns>
                </DataGrid>
                <Button Grid.Row="1" Content="Thu tiền phạt" Width="130" Height="34"
                        HorizontalAlignment="Right" Margin="0,14,0,0"
                        Command="{Binding ThuTienCommand}"
                        Background="#2E7D32" Foreground="White" BorderThickness="0" Cursor="Hand" />
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
