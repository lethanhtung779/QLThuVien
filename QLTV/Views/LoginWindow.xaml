<Window x:Class="QLTV.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng nhập" Height="420" Width="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F0F2F5"
        FontFamily="Segoe UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="LoginButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1F3864" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="10,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2B4C8A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Border Margin="30"
                Background="White"
                CornerRadius="12"
                Padding="25"
                BorderBrush="#D9DEE5"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="THƯ VIỆN QLTV"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#1F3864"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,5" />
                <TextBlock Text="Đăng nhập hệ thống quản lý"
                           FontSize="12"
                           Foreground="#8A94A6"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,25" />

                <TextBlock Text="Tài khoản" FontSize="13" Foreground="#4A5568" />
                <TextBox x:Name="txtTaiKhoan"
                         Height="34"
                         Margin="0,4,0,15"
                         Padding="8,5"
                         FontSize="13"
                         BorderBrush="#CBD2DC"
                         Text="{Binding TaiKhoan, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />

                <TextBlock Text="Mật khẩu" FontSize="13" Foreground="#4A5568" />
                <PasswordBox x:Name="txtMatKhau"
                             Height="34"
                             Margin="0,4,0,15"
                             Padding="8,5"
                             FontSize="13"
                             BorderBrush="#CBD2DC" />

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#D64545"
                           FontSize="12"
                           Margin="0,0,0,2"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Text="{Binding ErrorSummary}"
                           Foreground="#D64545"
                           FontSize="12"
                           Margin="0,0,0,10"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasErrorSummary, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <Button Content="Đăng nhập"
                        Style="{StaticResource LoginButtonStyle}"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Height="38"
                        IsDefault="True"
                        Click="LoginButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
