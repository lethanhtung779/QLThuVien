<UserControl x:Class="QLTV.Views.PhieuMuonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:QLTV.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:PhieuMuonViewModel}"
             mc:Ignorable="d"
             FontFamily="Segoe UI">
    <TabControl Background="Transparent" BorderThickness="0">
        <TabItem Header="Lập phiếu mượn">
            <Grid Margin="4,14,4,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Độc giả *" FontSize="13" Foreground="#4A5568" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" Height="32" FontSize="13"
                              ItemsSource="{Binding DanhSachDocGia}"
                              DisplayMemberPath="TenDocGia"
                              SelectedItem="{Binding SelectedDocGia}" />
                    <TextBlock Grid.Column="3" Text="Ngày mượn" FontSize="13" Foreground="#4A5568" VerticalAlignment="Center" />
                    <DatePicker Grid.Column="4" Height="32" FontSize="13" SelectedDate="{Binding NgayMuon}" />
                    <TextBlock Grid.Column="6" Text="Hạn trả" FontSize="13" Foreground="#4A5568" VerticalAlignment="Center" />
                    <DatePicker Grid.Column="7" Height="32" FontSize="13" SelectedDate="{Binding NgayHenTra}" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" CornerRadius="10" BorderBrush="#D9DEE5" BorderThickness="1" Padding="14">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Danh sách sách còn trong kho" FontSize="14" FontWeight="Bold"
                                       Foreground="#1F3864" Margin="0,0,0,10" />
                            <ListBox ItemsSource="{Binding DanhSachSachKhaDung}" BorderThickness="0" Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding HienThi}" IsChecked="{Binding IsChecked}" FontSize="13" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Button Content="&gt;" Width="48" Height="30" Margin="0,0,0,8"
                                Command="{Binding ChonSachCommand}"
                                Background="#1F3864" Foreground="White" BorderThickness="0" Cursor="Hand" />
                        <Button Content="&lt;" Width="48" Height="30"
                                Command="{Binding BoSachCommand}"
                                Background="#D64545" Foreground="White" BorderThickness="0" Cursor="Hand" />
                    </StackPanel>

                    <Border Grid.Column="2" Background="White" CornerRadius="10" BorderBrush="#D9DEE5" BorderThickness="1" Padding="14">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Sách đã chọn" FontSize="14" FontWeight="Bold"
                                       Foreground="#1F3864" Margin="0,0,0,10" />
                            <ListBox ItemsSource="{Binding SachDaChon}" BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding HienThi}" FontSize="13" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <TextBlock Text="{Binding ThongBao}"
                               Foreground="#2E7D32" FontSize="13" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Button Content="Lập phiếu mượn" Width="140" Height="36"
                            Command="{Binding LamPhieuCommand}"
                            Background="#1F3864" Foreground="White" BorderThickness="0" Cursor="Hand" />
                </StackPanel>
            </Grid>
        </TabItem>

        <TabItem Header="Trả sách / Theo dõi">
            <Grid Margin="4,14,4,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" />
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0"
                          ItemsSource="{Binding DanhSachPhieuDangMuon}"
                          SelectedItem="{Binding SelectedPhieu}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          Background="White"
                          BorderBrush="#D9DEE5"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeight="34"
                          FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã phiếu" Binding="{Binding PhieuMuon.MaPhieuMuon}" Width="0.7*" />
                        <DataGridTextColumn Header="Độc giả" Binding="{Binding TenDocGia}" Width="2*" />
                        <DataGridTextColumn Header="Ngày mượn" Binding="{Binding PhieuMuon.NgayMuon, StringFormat={}{0:dd/MM/yyyy}}" Width="1*" />
                        <DataGridTextColumn Header="Hạn trả" Binding="{Binding PhieuMuon.NgayHenTra, StringFormat={}{0:dd/MM/yyyy}}" Width="1*" />
                        <DataGridTextColumn Header="Số sách chưa trả" Binding="{Binding SoLuongSach}" Width="1.2*" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="1" Text="Chi tiết sách của phiếu được chọn"
                           FontSize="14" FontWeight="Bold" Foreground="#1F3864" Margin="0,16,0,8" />

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DataGrid Grid.Row="0"
                              ItemsSource="{Binding ChiTietPhieuDangChon}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              Background="White"
                              BorderBrush="#D9DEE5"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeight="34"
                              FontSize="13">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Sách" Binding="{Binding TenSach}" Width="3*" />
                            <DataGridTextColumn Header="Hạn trả" Binding="{Binding ChiTiet.PhieuMuon.NgayHenTra, StringFormat={}{0:dd/MM/yyyy}}" Width="1*" />
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThaiText}" Width="1*" />
                            <DataGridTemplateColumn Header="Thao tác" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Trả sách" Height="26" Padding="10,0"
                                                Command="{Binding DataContext.TraSachCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="#2E7D32" Foreground="White" BorderThickness="0" Cursor="Hand" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <TextBlock Text="{Binding ThongBaoTra}"
                                   Foreground="#2E7D32" FontSize="13" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <Button Content="Trả toàn bộ" Width="120" Height="32"
                                Command="{Binding TraTatCaCommand}"
                                Background="#1F3864" Foreground="White" BorderThickness="0" Cursor="Hand" />
                    </StackPanel>
                </Grid>
            </Grid>
        </TabItem>
        <TabItem Header="Lịch sử phiếu mượn">
            <Grid Margin="4,14,4,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBox Text="{Binding LichSuKeyword, UpdateSourceTrigger=PropertyChanged}"
                             Width="220" Height="32" Padding="8,5" FontSize="13"
                             VerticalContentAlignment="Center" BorderBrush="#CBD2DC"
                             ToolTip="Nhập mã phiếu hoặc tên độc giả" />
                    <TextBlock Text="Từ ngày" FontSize="13" Foreground="#4A5568" VerticalAlignment="Center" Margin="12,0,6,0" />
                    <DatePicker Height="32" FontSize="13" SelectedDate="{Binding LichSuTuNgay}" />
                    <TextBlock Text="Đến ngày" FontSize="13" Foreground="#4A5568" VerticalAlignment="Center" Margin="12,0,6,0" />
                    <DatePicker Height="32" FontSize="13" SelectedDate="{Binding LichSuDenNgay}" />
                    <Button Content="Lọc" Height="32" Padding="16,0" Margin="12,0,0,0"
                            Command="{Binding LocLichSuCommand}"
                            Background="#2E7D32" Foreground="White" BorderThickness="0" Cursor="Hand" />
                    <Button Content="In phiếu đã chọn" Height="32" Padding="16,0" Margin="8,0,0,0"
                            Command="{Binding InPhieuCommand}"
                            Background="#1F3864" Foreground="White" BorderThickness="0" Cursor="Hand" />
                </StackPanel>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding DanhSachLichSu}"
                          SelectedItem="{Binding SelectedLichSuPhieu}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          Background="White"
                          BorderBrush="#D9DEE5"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeight="34"
                          FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã phiếu" Binding="{Binding PhieuMuon.MaPhieuMuon}" Width="0.6*" />
                        <DataGridTextColumn Header="Độc giả" Binding="{Binding TenDocGia}" Width="1.6*" />
                        <DataGridTextColumn Header="Nhân viên lập" Binding="{Binding TenNhanVien}" Width="1.4*" />
                        <DataGridTextColumn Header="Ngày mượn" Binding="{Binding PhieuMuon.NgayMuon, StringFormat={}{0:dd/MM/yyyy}}" Width="1*" />
                        <DataGridTextColumn Header="Hạn trả" Binding="{Binding PhieuMuon.NgayHenTra, StringFormat={}{0:dd/MM/yyyy}}" Width="1*" />
                        <DataGridTextColumn Header="Tổng" Binding="{Binding TongSach}" Width="0.6*" />
                        <DataGridTextColumn Header="Đã trả" Binding="{Binding SoDaTra}" Width="0.6*" />
                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThaiText}" Width="1*" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="2" Text="Chi tiết phiếu được chọn"
                           FontSize="14" FontWeight="Bold" Foreground="#1F3864" Margin="0,16,0,8" />

                <DataGrid Grid.Row="3"
                          ItemsSource="{Binding ChiTietLichSu}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          Background="White"
                          BorderBrush="#D9DEE5"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeight="34"
                          FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Sách" Binding="{Binding TenSach}" Width="3*" />
                        <DataGridTextColumn Header="Hạn trả" Binding="{Binding ChiTiet.PhieuMuon.NgayHenTra, StringFormat={}{0:dd/MM/yyyy}}" Width="1*" />
                        <DataGridTextColumn Header="Ngày trả" Binding="{Binding ChiTiet.NgayTra, StringFormat={}{0:dd/MM/yyyy}}" Width="1*" />
                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThaiText}" Width="1*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
