<UserControl x:Class="QLTV.Views.SachView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:QLTV.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:SachViewModel}"
             mc:Ignorable="d"
             FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Width="260" Height="32" Padding="8,5" FontSize="13"
                     VerticalContentAlignment="Center" BorderBrush="#CBD2DC" />
            <Button Content="Tìm kiếm"
                    Height="32" Padding="16,0" Margin="8,0,0,0"
                    Command="{Binding SearchCommand}"
                    Background="#2E7D32" Foreground="White" BorderThickness="0"
                    Cursor="Hand" />
            <Button Content="+ Thêm sách"
                    Height="32" Padding="16,0" Margin="8,0,0,0"
                    Command="{Binding AddCommand}"
                    Background="#1F3864" Foreground="White" BorderThickness="0"
                    Cursor="Hand" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid Visibility="{Binding IsFormVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Background="White" CornerRadius="10" Padding="24" BorderBrush="#D9DEE5" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Thông tin sách"
                                   FontSize="16" FontWeight="Bold" Foreground="#1F3864"
                                   Margin="0,0,0,16" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Tên sách *" FontSize="13" Foreground="#4A5568" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1" Height="32" Padding="6,4" FontSize="13"
                                     Text="{Binding TenSach, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />

                            <TextBlock Grid.Row="0" Grid.Column="3" Text="Năm xuất bản" FontSize="13" Foreground="#4A5568" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="4" Height="32" Padding="6,4" FontSize="13"
                                     Text="{Binding NamXuatBan, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Thể loại *" FontSize="13" Foreground="#4A5568" VerticalAlignment="Center" Margin="0,12,0,0" />
                            <ComboBox Grid.Row="1" Grid.Column="1" Height="32" FontSize="13"
                                      ItemsSource="{Binding TheLoais}"
                                      DisplayMemberPath="TenTheLoai"
                                      SelectedItem="{Binding SelectedTheLoai, ValidatesOnDataErrors=True}"
                                      Margin="0,12,0,0" />

                            <TextBlock Grid.Row="1" Grid.Column="3" Text="Nhà xuất bản *" FontSize="13" Foreground="#4A5568" VerticalAlignment="Center" Margin="0,12,0,0" />
                            <ComboBox Grid.Row="1" Grid.Column="4" Height="32" FontSize="13"
                                      ItemsSource="{Binding NhaXuatBans}"
                                      DisplayMemberPath="TenNXB"
                                      SelectedItem="{Binding SelectedNxb, ValidatesOnDataErrors=True}"
                                      Margin="0,12,0,0" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Tác giả" FontSize="13" Foreground="#4A5568" VerticalAlignment="Center" Margin="0,12,0,0" />
                            <ComboBox Grid.Row="2" Grid.Column="1" Height="32" FontSize="13"
                                      ItemsSource="{Binding TacGias}"
                                      DisplayMemberPath="TenTacGia"
                                      SelectedItem="{Binding SelectedTacGia}"
                                      Margin="0,12,0,0" />

                            <TextBlock Grid.Row="2" Grid.Column="3" Text="Đơn giá (VNĐ)" FontSize="13" Foreground="#4A5568" VerticalAlignment="Center" Margin="0,12,0,0" />
                            <TextBox Grid.Row="2" Grid.Column="4" Height="32" Padding="6,4" FontSize="13"
                                     Text="{Binding TriGia, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                     Margin="0,12,0,0" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Tổng số lượng" FontSize="13" Foreground="#4A5568" VerticalAlignment="Center" Margin="0,12,0,0" />
                            <TextBox Grid.Row="3" Grid.Column="1" Height="32" Padding="6,4" FontSize="13"
                                     Text="{Binding SoLuong, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                     Margin="0,12,0,0" />

                            <TextBlock Grid.Row="3" Grid.Column="3" Text="Số lượng còn" FontSize="13" Foreground="#4A5568" VerticalAlignment="Center" Margin="0,12,0,0" />
                            <TextBox Grid.Row="3" Grid.Column="4" Height="32" Padding="6,4" FontSize="13"
                                     Text="{Binding SoLuongCon, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                     Margin="0,12,0,0" />
                        </Grid>

                        <TextBlock Text="Ghi chú" FontSize="13" Foreground="#4A5568" VerticalAlignment="Center" Margin="0,12,0,0" />
                        <TextBox Height="64" Padding="6,4" FontSize="13" AcceptsReturn="True"
                                 Text="{Binding GhiChu, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,4,0,0" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <TextBlock Text="{Binding ErrorSummary}"
                                       Foreground="#D64545" FontSize="12" VerticalAlignment="Center"
                                       Margin="0,0,14,0" MaxWidth="420" TextWrapping="Wrap" />
                            <Button Content="Lưu" Width="100" Height="34" Command="{Binding SaveCommand}"
                                    Background="#2E7D32" Foreground="White" BorderThickness="0" Cursor="Hand" />
                            <Button Content="Hủy" Width="100" Height="34" Margin="10,0,0,0"
                                    Command="{Binding CancelCommand}"
                                    Background="#D64545" Foreground="White" BorderThickness="0" Cursor="Hand" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Visibility="{Binding IsFormVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <DataGrid ItemsSource="{Binding DanhSachSach}"
                          SelectedItem="{Binding SelectedSach}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          Background="White"
                          BorderBrush="#D9DEE5"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeight="36"
                          FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tên sách" Binding="{Binding Sach.TenSach}" Width="2*" />
                        <DataGridTextColumn Header="Thể loại" Binding="{Binding TenTheLoai}" Width="1.2*" />
                        <DataGridTextColumn Header="Nhà xuất bản" Binding="{Binding TenNXB}" Width="1.4*" />
                        <DataGridTextColumn Header="Tác giả" Binding="{Binding TacGias}" Width="1.4*" />
                        <DataGridTextColumn Header="Năm XB" Binding="{Binding Sach.NamXuatBan}" Width="0.7*" />
                        <DataGridTextColumn Header="Tổng" Binding="{Binding Sach.SoLuong}" Width="0.6*" />
                        <DataGridTextColumn Header="Còn lại" Binding="{Binding Sach.SoLuongCon}" Width="0.7*" />
                        <DataGridTextColumn Header="Đơn giá" Binding="{Binding Sach.TriGia, StringFormat={}{0:N0}}" Width="0.9*" />
                        <DataGridTemplateColumn Header="Thao tác" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Sửa" Height="26" Padding="10,0" Margin="0,0,6,0"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="#EF6C00" Foreground="White" BorderThickness="0" Cursor="Hand" />
                                        <Button Content="Xóa" Height="26" Padding="10,0"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="#D64545" Foreground="White" BorderThickness="0" Cursor="Hand" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
