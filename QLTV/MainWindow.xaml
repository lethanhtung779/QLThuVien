<Window x:Class="QLTV.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:QLTV.ViewModels"
        xmlns:views="clr-namespace:QLTV.Views"
        Title="Quản lý thư viện"
        Height="700" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F0F2F5"
        FontFamily="Segoe UI">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SachViewModel}">
            <views:SachView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DocGiaViewModel}">
            <views:DocGiaView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PhieuMuonViewModel}">
            <views:PhieuMuonView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ThongKeViewModel}">
            <views:ThongKeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NhanVienViewModel}">
            <views:NhanVienView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:QuyDinhViewModel}">
            <views:QuyDinhView />
        </DataTemplate>

        <Style x:Key="MenuItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#CFD9EA" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" Padding="20,13">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2B4C8A" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3E67B3" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LogoutButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#A8B8D8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="10,7">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2B4C8A" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#1F3864">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="22,25,22,20">
                    <TextBlock Text="QLTV" FontSize="26" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="Quản lý thư viện" FontSize="12" Foreground="#7E93B8" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="14,12">
                    <TextBlock Text="{Binding UserInfo}"
                               Foreground="#CFD9EA"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="8,0,8,10" />
                    <Button Content="Đăng xuất"
                            Style="{StaticResource LogoutButtonStyle}"
                            FontSize="13"
                            Command="{Binding LogoutCommand}" />
                </StackPanel>

                <ListBox ItemsSource="{Binding MenuItems}"
                         SelectedItem="{Binding SelectedMenuItem}"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource MenuItemStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" FontSize="14" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="#D9DEE5" BorderThickness="0,0,0,1">
                <TextBlock Text="{Binding SelectedMenuItem.DisplayName}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#1F3864"
                           VerticalAlignment="Center"
                           Margin="24,0" />
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" Margin="24" />
        </Grid>
    </Grid>
</Window>
